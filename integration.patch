diff --git a/runtime/pausemenu.c b/runtime/pausemenu.c
new file mode 100644
index 0000000..3fa6fb2
--- /dev/null
+++ b/runtime/pausemenu.c
@@ -0,0 +1,82 @@
+/* pausemenu.c -- shared extensions to the in-world pause menu.
+ *
+ * The pause menus add every option through 0x50DAB0, and Replay-kind items
+ * send their actions through 0x4C26B0.  These addresses can each have only
+ * one dispatch owner, so this file owns them and gives Save, Photo Mode,
+ * local co-op and D4Tune their ordered callbacks.
+ *
+ * Photo Mode and local co-op are anchored after the stock Replay item.  Save
+ * and D4Tune choose their own anchors while AddOption walks the menu. */
+#include "cpu.h"
+#include "guest.h"
+#include <stdint.h>
+
+void dispatch_patch(uint32_t a, void (*f)(CPU *));
+
+#define FN_REPLAY_ACT 0x004c26b0u
+#define FN_ADD_ITEM   0x0050dab0u
+
+int photo_pause_replay(CPU *c, uint32_t item);
+uint32_t photo_pause_item(CPU *c);
+int photo_pause_accept(CPU *c);
+void savegame_item(CPU *c, uint32_t menu, uint32_t item);
+int savegame_accept(CPU *c);
+void coop_item(CPU *c, uint32_t menu);
+int coop_act(CPU *c);
+
+__attribute__((weak)) int d4tune_before_add(CPU *c, uint32_t menu, uint32_t item);
+__attribute__((weak)) void d4tune_after_add(CPU *c, uint32_t menu, uint32_t item);
+__attribute__((weak)) int d4tune_pause_accept(CPU *c);
+
+static uint32_t photo_after;
+static uint32_t coop_after;
+
+/* The stock Replay item has just been constructed.  Photo Mode goes after it
+ * when available; local co-op follows Photo Mode, or Replay without it. */
+void sub_004c2640_orig(CPU *c);
+void sub_004c2640(CPU *c){
+    uint32_t item = c->ecx;
+    sub_004c2640_orig(c);
+    if (photo_pause_replay(c, item)){
+        photo_after = item;
+        coop_after = 0;
+    } else {
+        photo_after = 0;
+        coop_after = item;
+    }
+}
+
+void sub_0050dab0(CPU *c);
+static void add_item(CPU *c){
+    uint32_t menu = c->ecx, item = MR32(c->esp + 4u);
+    if (d4tune_before_add && d4tune_before_add(c, menu, item)) return;
+    sub_0050dab0(c);
+    savegame_item(c, menu, item);
+    if (d4tune_after_add) d4tune_after_add(c, menu, item);
+    if (item && item == coop_after){
+        coop_after = 0;
+        coop_item(c, menu);
+    }
+    if (!item || item != photo_after) return;
+    photo_after = 0;
+    uint32_t photo = photo_pause_item(c);
+    if (!photo) return;
+    coop_after = photo;
+    gcall_main(c, FN_ADD_ITEM, menu, 1, &photo);
+}
+
+void sub_004c26b0(CPU *c);
+static void act(CPU *c){
+    if (d4tune_pause_accept && d4tune_pause_accept(c)) return;
+    if (savegame_accept(c)) return;
+    int co = coop_act(c);
+    if (co == 1){ POP32(c->eip); c->esp += 0x14u; return; }
+    if (co == 2) return;
+    if (photo_pause_accept(c)) return;
+    sub_004c26b0(c);
+}
+
+void pausemenu_install(void){
+    dispatch_patch(FN_REPLAY_ACT, act);
+    dispatch_patch(FN_ADD_ITEM, add_item);
+}
